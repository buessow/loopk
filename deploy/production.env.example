# Copy to /opt/outabout-infra/services/loopk/.env on the server, chmod 600.
# Keep this file out of Git: it has the database password and Google secret.
PORT=8084
BASE_URL=https://loopk.outabout.cc
DATABASE_URL=postgres://loopk:REPLACE_WITH_LOOPK_PASSWORD@127.0.0.1:5432/loopk
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
ADMIN_EMAILS=REPLACE_WITH_ADMIN_GOOGLE_EMAIL

# Optional: enables Loopk's database freshness metrics in New Relic.
# The monitor service uses this key; its application name is "Loopk monitor".
NEW_RELIC_LICENSE_KEY=

# Optional during migration from an existing Nightscout instance.
# FOLLOW_URL=https://example.invalid
# FOLLOW_TOKEN=REPLACE_WITH_READ_TOKEN
