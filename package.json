{
  "name": "loopk",
  "version": "0.1.0",
  "description": "Nightscout-compatible CGM server backed by PostgreSQL",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "AUTH_DISABLED=true node --watch --env-file-if-exists=.env src/server.js",
    "token": "node --env-file-if-exists=.env src/cli/token.js",
    "render:production-env": "node --env-file=.env scripts/render-production-env.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 'test/**/*.test.js'",
    "analyze:mongo": "node --env-file-if-exists=.env scripts/mongo-analyze.js",
    "migrate:mongo": "node --env-file-if-exists=.env scripts/mongo-migrate.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "google-auth-library": "^11.3.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "mongodb": "^6.21.0",
    "supertest": "^7.3.1"
  }
}
